# Laptop mode: Ollama runs natively on the Mac (Metal GPU); the gateway runs
# natively or in Docker. Copy to .env (git-ignored) and fill in LGAI_ADMIN_TOKEN.
#
#   Native (preferred on shared Wi-Fi, Ollama stays on 127.0.0.1):
#     set -a && . ./.env && set +a && go run ./cmd/gateway
#   Docker:
#     docker compose up --build
#     docker-compose.yml overrides LGAI_ADDR, LGAI_ADMIN_ADDR, LGAI_DB_PATH and
#     LGAI_UPSTREAM_BASE_URL with container values; everything else comes from here.
#
# Start Ollama first. Ollama's default context (4096) is too small for 16 KiB inputs:
#   OLLAMA_NUM_PARALLEL=4 OLLAMA_CONTEXT_LENGTH=8192 OLLAMA_KEEP_ALIVE=-1 OLLAMA_MAX_QUEUE=16 ollama serve
# Never set OLLAMA_HOST=0.0.0.0 on a shared network (security review #23).
#
# Format notes: comments go on their own lines. Values that contain ';' or JSON are
# single-quoted; both `docker compose` and `. ./.env` then read them literally.
# `docker run --env-file` does NOT strip quotes: remove them there.
# An empty value means "use the built-in default" (or "off" for secrets).
# Knob values: docs/DECISIONS.md D6, laptop column (M4 Pro, Ollama).

# ---- Listeners ------------------------------------------------------------
# Loopback only (security #23). Compose uses :8080 in the container and publishes 127.0.0.1:8080.
LGAI_ADDR=127.0.0.1:8080
# Admin API listener. It starts only when LGAI_ADMIN_TOKEN is set.
LGAI_ADMIN_ADDR=127.0.0.1:8081
LGAI_ADMIN_ON_PUBLIC=false
# At least 43 chars and 16 distinct chars; no placeholder words. Empty = admin API off.
# generate: openssl rand -base64 32   (or: go run ./cmd/gateway gen-secret)
LGAI_ADMIN_TOKEN=
# Or read it from a 0600 file instead (leave LGAI_ADMIN_TOKEN empty then).
LGAI_ADMIN_TOKEN_FILE=

# ---- Storage, logs, keys --------------------------------------------------
LGAI_DB_PATH=data/gateway.db
LGAI_LOG_LEVEL=info
# Default lifetime of new keys; 0 = no expiry (mint-keys.sh sets an explicit expiry instead).
LGAI_KEY_TTL=0
# Pre-minted key hashes imported at startup (DECISIONS D2, same-container topology). Empty = off.
LGAI_KEYS_FILE=

# ---- Model ------------------------------------------------------------------
# Clients always send model "coder" (D3). The upstream id must be pulled: ollama pull gpt-oss:20b
LGAI_MODELS=coder=gpt-oss:20b
# gpt-oss always reasons; "low" keeps reasoning from eating max_tokens (critic M3).
LGAI_MODEL_DEFAULTS='coder={"reasoning_effort":"low"}'
# A/B candidate on time-to-first-content (D3): non-thinking, so no defaults needed:
# LGAI_MODELS=coder=qwen2.5-coder:7b
# LGAI_MODEL_DEFAULTS=

# ---- Upstream (Ollama) ------------------------------------------------------
# Including /v1. Compose replaces it with http://host.docker.internal:11434/v1.
LGAI_UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1
# Ollama has no auth; a loopback/private upstream needs none.
LGAI_UPSTREAM_API_KEY=
LGAI_UPSTREAM_API_KEY_FILE=
LGAI_UPSTREAM_HEADERS=
LGAI_UPSTREAM_HEADERS_FILE=
# Empty = GET {base}/models
LGAI_UPSTREAM_HEALTH_URL=
LGAI_UPSTREAM_ALLOW_UNAUTHENTICATED=false
# First streamed byte; covers a cold model load.
LGAI_UPSTREAM_HEADER_TIMEOUT=120s
# Silence between SSE events mid-stream.
LGAI_UPSTREAM_IDLE_TIMEOUT=60s
# Hard cap per upstream request.
LGAI_UPSTREAM_TIMEOUT=10m

# ---- Capacity and limits ----------------------------------------------------
# Must equal OLLAMA_NUM_PARALLEL.
LGAI_MAX_INFLIGHT=4
LGAI_QUEUE_SIZE=16
LGAI_QUEUE_TIMEOUT=60s
LGAI_OVERLOAD_RETRY_AFTER=10s
LGAI_RATE_RPM=6
LGAI_RATE_BURST=3
LGAI_KEY_MAX_INFLIGHT=1
LGAI_TOKEN_QUOTA_DAILY=300000

# ---- Generation defaults and input caps -------------------------------------
LGAI_CHAT_DEFAULT_MAX_TOKENS=512
LGAI_MAX_TOKENS_CAP=1024
LGAI_NONSTREAM_MAX_TOKENS=768
LGAI_TASK_MAX_INPUT_BYTES=16384
# 16 KiB of code is ~4.7k tokens; plus LGAI_MAX_TOKENS_CAP it fits an 8192-token context.
LGAI_CHAT_MAX_INPUT_BYTES=16384
LGAI_MAX_BODY_BYTES=262144

# ---- HTTP server ------------------------------------------------------------
LGAI_READ_HEADER_TIMEOUT=10s
# Short: one slow body holds a connection until it expires (security-code V1).
LGAI_BODY_READ_TIMEOUT=10s
LGAI_WRITE_TIMEOUT=10s
LGAI_IDLE_TIMEOUT=120s
LGAI_SHUTDOWN_TIMEOUT=30s
LGAI_MAX_CONNS=256
