# Server mode, DECISIONS D2 as decided by Slava: the gateway container and its
# SQLite file run on a separate always-on CPU VM with a persistent disk, behind
# Caddy/nginx TLS on a stable DNS name (Jan). The GPU (vLLM on Modal, one L40S)
# is only the upstream. Setup: docs/HANDOFF-jan.md.
#
# Copy to /opt/lgai/.env on the VM (chmod 600, never commit it) and fill in every
# empty secret; as shipped the gateway refuses to start. A provider switch
# (runbook L2) is an edit of the Upstream block plus `docker compose up -d`:
# students keep their URL and keys, because the keys live in SQLite on the VM.
#
# Written for the gateway container (image defaults: LGAI_ADDR=:8080,
# LGAI_DB_PATH=/data/gateway.db). The VM publishes 127.0.0.1:8080:8080 (only
# the proxy talks to it) and 127.0.0.1:8081:8081 (admin, reached via
# ssh -N -L 8081:127.0.0.1:8081 <vm>).
#
# Format notes: comments go on their own lines; values containing ';' or JSON
# are single-quoted (read literally by docker compose and by `. ./.env`;
# `docker run --env-file` keeps the quotes, so remove them there).
# Knob values: docs/DECISIONS.md D6, server column (L40S, vLLM --max-num-seqs 32).

# ---- Listeners ------------------------------------------------------------
LGAI_ADDR=:8080
LGAI_ADMIN_ADDR=:8081
# true only for the same-container topology (single exposed port); logs a WARN.
LGAI_ADMIN_ON_PUBLIC=false
# generate: openssl rand -base64 32   (store it in the password manager; two people hold it)
LGAI_ADMIN_TOKEN=
# Or mount a 0600 secret file and point to it (leave LGAI_ADMIN_TOKEN empty then).
LGAI_ADMIN_TOKEN_FILE=

# ---- Storage, logs, keys --------------------------------------------------
# On the named volume; survives container restarts.
LGAI_DB_PATH=/data/gateway.db
LGAI_LOG_LEVEL=info
# 0 = no default expiry; lab keys get an explicit expires_at from scripts/mint-keys.sh.
LGAI_KEY_TTL=0
# Same-container topology only (ephemeral disk): pre-minted key hashes imported at startup.
LGAI_KEYS_FILE=

# ---- Model ------------------------------------------------------------------
# Must equal vLLM --served-model-name (default: the HF id).
LGAI_MODELS=coder=Qwen/Qwen3.6-35B-A3B-FP8
# Qwen3.6 thinks by default; turn it off per request as a second layer behind
# vLLM --default-chat-template-kwargs (critic M3).
LGAI_MODEL_DEFAULTS='coder={"chat_template_kwargs":{"enable_thinking":false}}'
# Pre-decided fallback on the same GPU (D3, critic M7), non-thinking:
# LGAI_MODELS=coder=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
# LGAI_MODEL_DEFAULTS=
# Optional: Qwen3.6 non-thinking sampling from docs/research/model-choice.md (chat only;
# task endpoints set their own temperature):
# LGAI_MODEL_DEFAULTS='coder={"chat_template_kwargs":{"enable_thinking":false},"temperature":0.7,"top_p":0.8,"top_k":20,"presence_penalty":1.5}'

# ---- Upstream (vLLM on Modal) -----------------------------------------------
# The URL `modal deploy` prints for the vLLM app, plus /v1. For a web function
# (@modal.web_server) it looks like https://<workspace>--<app>-<function>.modal.run;
# the current Modal docs show *.modal.direct for an @app.server. Copy it exactly.
LGAI_UPSTREAM_BASE_URL=https://WORKSPACE--lgai-vllm.modal.run/v1
# Same value as vllm --api-key (the Modal secret VLLM_API_KEY).
# generate: openssl rand -base64 32
LGAI_UPSTREAM_API_KEY=
LGAI_UPSTREAM_API_KEY_FILE=
# Modal proxy auth: a proxy token from the Modal dashboard (Settings > Proxy Auth
# Tokens) or `modal workspace proxy-tokens`: Modal-Key=wk-...;Modal-Secret=ws-...
# The gateway refuses to start while an entry is empty. Or use LGAI_UPSTREAM_HEADERS_FILE.
LGAI_UPSTREAM_HEADERS='Modal-Key=;Modal-Secret='
LGAI_UPSTREAM_HEADERS_FILE=
# Empty = GET {base}/models (checks the proxy token and the API key together).
# A Modal Server with no running container answers 503, so /readyz shows the GPU is down.
LGAI_UPSTREAM_HEALTH_URL=
LGAI_UPSTREAM_ALLOW_UNAUTHENTICATED=false
LGAI_UPSTREAM_HEADER_TIMEOUT=60s
LGAI_UPSTREAM_IDLE_TIMEOUT=30s
LGAI_UPSTREAM_TIMEOUT=5m
#
# Not chosen, kept for reference: the same-container topology (D2 alternative),
# with vLLM on 127.0.0.1 next to the gateway:
# LGAI_UPSTREAM_BASE_URL=http://127.0.0.1:8000/v1
# LGAI_UPSTREAM_HEALTH_URL=http://127.0.0.1:8000/health
# LGAI_UPSTREAM_HEADERS=
# LGAI_ADMIN_ON_PUBLIC=true
# LGAI_KEYS_FILE=/run/secrets/lgai-key-hashes

# ---- Capacity and limits ----------------------------------------------------
# <= vLLM --max-num-seqs (32).
LGAI_MAX_INFLIGHT=30
LGAI_QUEUE_SIZE=24
LGAI_QUEUE_TIMEOUT=30s
LGAI_OVERLOAD_RETRY_AFTER=10s
LGAI_RATE_RPM=6
LGAI_RATE_BURST=3
LGAI_KEY_MAX_INFLIGHT=2
LGAI_TOKEN_QUOTA_DAILY=300000

# ---- Generation defaults and input caps -------------------------------------
LGAI_CHAT_DEFAULT_MAX_TOKENS=512
# 1536 until the day-1 test proves Modal streams survive 150 s; then 2048 (D1).
LGAI_MAX_TOKENS_CAP=1536
LGAI_NONSTREAM_MAX_TOKENS=1024
LGAI_TASK_MAX_INPUT_BYTES=16384
# 16 KiB of code is ~4.7k tokens; plus LGAI_MAX_TOKENS_CAP it fits an 8192-token context.
LGAI_CHAT_MAX_INPUT_BYTES=16384
LGAI_MAX_BODY_BYTES=262144

# ---- HTTP server ------------------------------------------------------------
LGAI_READ_HEADER_TIMEOUT=10s
# Short: one slow body holds a connection until it expires (security-code V1).
LGAI_BODY_READ_TIMEOUT=10s
LGAI_WRITE_TIMEOUT=10s
LGAI_IDLE_TIMEOUT=120s
LGAI_SHUTDOWN_TIMEOUT=30s
LGAI_MAX_CONNS=256
