# Secrets and local state never enter the repo (security review #10).
# GitHub secret scanning does not know the lgai_ key format.
.env
.env.*
!.env.*.example
data/
*.db
*.db-wal
*.db-shm
keys*.csv
keys-slips*.md
*.keys
*.pem
*.key
/loadtest-results/

# Build output
bin/
/gateway
/loadtest

# IDE: shared project settings stay tracked; per-user state does not
.idea/workspace.xml
.idea/shelf/
.idea
