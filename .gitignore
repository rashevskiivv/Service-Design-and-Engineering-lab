.env
.env.*
!.env.*.example
data/
*.db
*.db-wal
*.db-shm
keys*.csv
keys-slips*.md
*.keys
*.pem
*.key

# Build output
bin/
/gateway

# IDE: shared project settings stay tracked; per-user state does not
.idea/workspace.xml
.idea/shelf/
.idea

# Local secrets and transfer files
key.json
.lgai-xfer/
.DS_Store
